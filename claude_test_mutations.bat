@echo off
chcp 65001 >nul
cd /d "%~dp0"
rem ==========================================================================
rem  claude_test_mutations.bat       = فحص الطفرات: 12 خطأ حسابي متعمّد، واحداً تلو الآخر
rem  claude_test_mutations.bat M05   = طفرة واحدة فقط
rem  كل طفرة: يُكتب الخطأ في ملف واحد ← تُشغَّل اختباراته ← يُعاد الملف فوراً ويُتحقق
rem  من بصمته. «كُشفت» = الاختبار يحمي؛ «نجت» = ثغرة في الاختبارات.
rem  ⚠️ لا تبنِ البرنامج ولا تعدّل الكود أثناء تشغيله (يُعدّل ملفات lib مؤقتاً).
rem  Ctrl+C آمن (يعيد الملف). وإن انطفأ الحاسوب يُعاد الملف في التشغيل التالي.
rem  النتيجة: test_results\mutations\report.txt (والسجل الكامل log_*.txt)
rem ==========================================================================
echo فحص الطفرات — يأخذ 30 إلى 90 دقيقة. لا تغلق النافذة.
call dart run tool\mutation_test.dart %1
set RC=%ERRORLEVEL%
echo.
if "%RC%"=="0" (echo ✅ نجح الاختبار — كل الطفرات كُشفت) else (echo ❌ هنا وقع خطأ — أرسل لي test_results\mutations\report.txt)
exit /b %RC%
