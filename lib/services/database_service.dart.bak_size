    'كرتون',
    'باكيت',
    'علبة',
    'كيس',
    'صندوق',
    'شد',
    'رزمة',
    // وحدات متنوعة
    'سيت',
    'طقم',
    'درزن',
    'دزينة',
    'رول',
    'لفة',
    'طول',
