  /// 🚀 جلب جميع الزبائن مع Cache ذكي
  /// reportSource: 'all' = الكل, 'this_device' = هذا الجهاز فقط, 'sync' = المزامنة فقط
  Future<List<Customer>> getPaginatedCustomersForReports({
    required int limit,
